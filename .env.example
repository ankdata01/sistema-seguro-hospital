# Plantilla de configuración. No contiene secretos ni credenciales reales.
APP_ENV=production
DEMO_MODE=false
DEMO_TOTP_VIEWER=false
COOKIE_SECURE=true
HTTPS_ONLY=true

# Obligatorio: generar en tiempo de ejecución; no versionar el valor real.
SECRET_KEY=<GENERAR_EN_TIEMPO_DE_EJECUCION>

# Opcional para una demo repetible. Si queda vacío, db.semilla genera una
# contraseña aleatoria y la imprime una sola vez en la consola.
DEMO_PASSWORD=<OPCIONAL_NO_VERSIONAR>
